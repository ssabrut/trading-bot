# Postgres (MLflow backend store)
POSTGRES_USER=mlflow
POSTGRES_PASSWORD=change-me
POSTGRES_DB=mlflow

# MinIO (MLflow artifact store)
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=change-me-too
MLFLOW_BUCKET=mlflow

# Client-side (used by training scripts, not the mlflow server container)
MLFLOW_TRACKING_URI=http://localhost:5000
MLFLOW_S3_ENDPOINT_URL=http://localhost:9000
AWS_ACCESS_KEY_ID=minioadmin
AWS_SECRET_ACCESS_KEY=change-me-too
